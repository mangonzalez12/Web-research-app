# Copy to .env and fill in. .env is git-ignored; never commit it.
# Comma-separated usernames (lowercase). The first one is the admin.
APP_USERS=user1,user2,user3
# One password per user: APP_PASS_<USERNAME in uppercase>. Use long, unique passwords
# (e.g. `openssl rand -base64 18`).
APP_PASS_USER1=
APP_PASS_USER2=
APP_PASS_USER3=

# Optional: public address used in participant links (needed behind a proxy / on Heroku)
# PUBLIC_URL=https://your-app.example.com/
